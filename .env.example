# Required — DatoCMS Content Delivery API (read-only) token. Used by the app/build.
DATO_CMS_READONLY_TOKEN=your_dato_cms_cda_token

# Optional — DatoCMS Content Management API (write) token. Used only by local
# content-seeding/admin scripts, not by the app build.
DATO_CMS_CMA_TOKEN=your_dato_cms_cma_token

# Optional — canonical public site URL (currently not referenced by the app).
PUBLIC_SITE_URL=https://jashmuun.com/ru/
